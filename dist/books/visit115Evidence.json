f7af","photo-2abd1fcb1a4d10d2","photo-dc1343c473d9ba53","photo-96896b7ef0814415"],"heading":false},{"kind":"p","text":"本學期教材把耆老口述、教師共備、學生田野紀錄、課堂作品、科學探究與數位延伸統整為可再教學的課程資產。整體教材產出共13項，包含完整教案附件8份、出版教材書稿1冊《O riyar ato lotok a kongko ita 我們與山海之間的故事》、線上教材3套及歌曲教材1首。","images":[],"heading":false},{"kind":"p","text":"114學年度第二學期教材製作與數量統整","images":[],"heading":false},{"kind":"table","rows":[[[{"kind":"p","text":"類別","images":[],"heading":false}],[{"kind":"p","text":"教材名稱","images":[],"heading":false}],[{"kind":"p","text":"數量","images":[],"heading":false}],[{"kind":"p","text":"內容與用途","images":[],"heading":false}]],[[{"kind":"p","text":"教案","images":[],"heading":false}],[{"kind":"p","text":"低年級山海生活課程教案／紀錄","images":[],"heading":false}],[{"kind":"p","text":"1份","images":[],"heading":false}],[{"kind":"p","text":"統整農耕、野菜、潮間帶、服飾、歌謠與祭典圖像等基礎文化經驗，作為低年級文化感知與生活實作教材。","images":[],"heading":false}]],[[{"kind":"p","text":"","images":[],"heading":false}],[{"kind":"p","text":"低年級山海人文課程教案／紀錄","images":[],"heading":false}],[{"kind":"p","text":"1份","images":[],"heading":false}],[{"kind":"p","text":"","images":[],"heading":false}]],[[{"kind":"p","text":"","images":[],"heading":false}],[{"kind":"p","text":"中年級山海藝術課程教案／紀錄","images":[],"heading":false}],[{"kind":"p","text":"1份","images":[],"heading":false}],[{"kind":"p","text":"統整海祭、祈雨祈晴、落成樂舞、十字繡、服飾與工藝美感，作為中年級文化表現與藝術轉譯教材。","images":[],"heading":false}]],[[{"kind":"p","text":"","images":[],"heading":false}],[{"kind":"p","text":"中年級山海專題Kamamit慢食與野番茄專題教案／紀錄","images":[],"heading":false}],[{"kind":"p","text":"1份","images":[],"heading":false}],[{"kind":"p","text":"統整野番茄、Tatokem、慢食、加工與品牌設計，連結食農創新、成果展攤位與學生作品。","images":[],"heading":false}]],[[{"kind":"p","text":"","images":[],"heading":false}],[{"kind":"p","text":"高年級山海藝術與Loma’家屋教案／紀錄","images":[],"heading":false}],[{"kind":"p","text":"1份","images":[],"heading":false}],[{"kind":"p","text":"統整Mipacing漁獵、海祭踏查、家屋模型與科展研究，作為高年級探究與專題教材。","images":[],"heading":false}]],[[{"kind":"p","text":"","images":[],"heading":false}],[{"kind":"p","text":"高年級山海人文與海祭、豐年祭教案／紀錄","images":[],"heading":false}],[{"kind":"p","text":"1份","images":[],"heading":false}],[{"kind":"p","text":"","images":[],"heading":false}]],[[{"kind":"p","text":"","images":[],"heading":false}],[{"kind":"p","text":"高年級山海專題Mipacing漁獵文化教案／紀錄","images":[],"heading":false}],[{"kind":"p","text":"1份","images":[],"heading":false}],[{"kind":"p","text":"","images":[],"heading":false}]],[[{"kind":"p","text":"出版教材","images":[],"heading":false}],[{"kind":"p","text":"《O riyar ato lotok a kongko ita 我們與山海之間的故事》","images":["photo-4da230c1352af7c6"],"heading":false}],[{"kind":"p","text":"1冊","images":[],"heading":false}],[{"kind":"p","text":"","images":["photo-7c53a92344abc64a"],"heading":false},{"kind":"p","text":"出版教材內容說明：《O riyar ato lotok a kongko ita 我們與山海之間的故事》以「山海之間」為主軸，內容包含Lotok ato Riyar山海路徑、Ngangan名字與氏族記憶、Dateng野菜與物候、Pasongan農事與山林智慧、Sacepo’海祭與Mipacing漁獵、Riyar海洋倫理，以及Selal年齡階層、Kawas宇宙觀與Misarao’歲時祭儀。教材將課程紀錄、耆老知識、學生探究與圖像資料整理為可閱讀、可引用、可延伸教學的附件出版內容。","images":[],"heading":false}]],[[{"kind":"p","text":"線上教材","images":[],"heading":false},{"kind":"p","text":"","images":[],"heading":false}],[{"kind":"p","text":"原科解密https://laierin615.github.io/yuan-ke-jie-mi/","images":["photo-469966c1a0b051ff"],"heading":false}],[{"kind":"p","text":"1套","images":[],"heading":false}],[{"kind":"p","text":"將原住民族知識、課程概念與學習任務轉為可線上瀏覽的教材，供學生、教師使用。","images":[],"heading":false},{"kind":"p","text":"","images":["photo-3e70e10875b843ec"],"heading":false}]],[[{"kind":"p","text":"","images":[],"heading":false}],[{"kind":"p","text":"Dateng 野菜文化https://laierin615.github.io/laierindateng/","images":["photo-b77f6bd556cecf9d"],"heading":false}],[{"kind":"p","text":"1套","images":[],"heading":false}],[{"kind":"p","text":"","images":["photo-50e4c86c6b04af43"],"heading":false}]],[[{"kind":"p","text":"","images":[],"heading":false}],[{"kind":"p","text":"Mipacing https://mipacing-pov-game.nbps14467101.chatgpt.site/game","images":["photo-f3af2afa214b7fa2"],"heading":false}],[{"kind":"p","text":"1套","images":[],"heading":false}],[{"kind":"p","text":"統整漁獵專題、科學實驗、文化倫理與簡報表達，支援科展說明、成果展導覽與課堂複習。","images":["photo-47418db7f0b8c3fa"],"heading":false}]],[[{"kind":"p","text":"","images":[],"heading":false}],[{"kind":"p","text":"十字繡","images":[],"heading":false},{"kind":"p","text":"","images":["photo-8d204457ebea4faf"],"heading":false},{"kind":"p","text":"https://salimpo-curriculum.nbps14467101.chatgpt.site/#/mitesel","images":[],"heading":false}],[{"kind":"p","text":"1套","images":[],"heading":false}],[{"kind":"p","text":"把阿美族十字繡從「好看的手作」轉化為可觀察、可練習、可對話的文化學習歷程。學生從八角星與情人袋圖像中看見形狀、對稱、配色與構圖，再透過走針動畫、黑布紅線心靜繡室與五種練習圖樣，學習數格、專注、耐心與手眼協調，同時讓阿美語 Mitesel 成為課程中明顯而重要的文化詞彙。此數位教材連結族語、工藝、生活記憶、身心安定與文化傳承。","images":[],"heading":false},{"kind":"p","text":"","images":["photo-74f21c5ffdfca22d"],"heading":false}]],[[{"kind":"p","text":"歌曲教材","images":[],"heading":false}],[{"kind":"p","text":"祈晴歌（新創）","images":["photo-f3af2afa214b7fa2"],"heading":false}],[{"kind":"p","text":"1首","images":[],"heading":false}],[{"kind":"p","text":"作為祈雨祈晴、山海藝音與祭儀文化課程的當代創作教材，協助學生以歌謠理解天候、土地與文化祈願。","images":[],"heading":false}]]]}]},{"title":"04 課程評量與學習證據","blocks":[{"kind":"p","text":"（六）評量規準之課程對應與學習證據","images":[],"heading":false},{"kind":"table","rows":[[[{"kind":"p","text":"課程主軸（年段）","images":[],"heading":false}],[{"kind":"p","text":"文化理解（30%）","images":[],"heading":false}],[{"kind":"p","text":"實作表現（40%）","images":[],"heading":false}],[{"kind":"p","text":"族語表達（30%）","images":[],"heading":false}],[{"kind":"p","text":"主要學習證據","images":[],"heading":false}]],[[{"kind":"p","text":"山海生活：農耕、野菜、潮間帶（低年級）","images":[],"heading":false}],[{"kind":"p","text":"辨識校園與部落常見作物、野菜及潮間帶生物；理解「一起種、一起吃、一起分享」的生活價值與採集分寸。","images":[],"heading":false}],[{"kind":"p","text":"整地、播種、澆水、除草、採集、挑菜與野菜料理；工具使用與田間安全。","images":[],"heading":false}],[{"kind":"p","text":"作物與生物族語名稱、日常問候與課堂用語。","images":[],"heading":false}],[{"kind":"p","text":"田間實作檢核、作物觀察卡、Padlet 照片與錄音、野菜料理成品與成果照片。","images":[],"heading":false}]],[[{"kind":"p","text":"山海人文、山海藝音、山海藝術（低年級）","images":[],"heading":false}],[{"kind":"p","text":"傳統信仰、海祭與豐年祭之祭儀脈絡與場域倫理。","images":[],"heading":false}],[{"kind":"p","text":"海祭與豐年祭繪畫、生活樂舞組曲、串珠與色彩作品。","images":[],"heading":false}],[{"kind":"p","text":"祭儀相關詞彙、歌謠跟唱。","images":[],"heading":false}],[{"kind":"p","text":"繪畫與串珠作品、樂舞展演、課堂觀察與參與態度紀錄。","images":[],"heading":false}]],[[{"kind":"p","text":"山海生活與山海人文（中年級）","images":[],"heading":false}],[{"kind":"p","text":"農耕技術背後的節氣與部落經驗、潮間帶生物棲地與季節。","images":[],"heading":false}],[{"kind":"p","text":"花生種植與田間管理、潮間生物觀察與紀錄。","images":[],"heading":false}],[{"kind":"p","text":"作物與潮間生物族語詞彙、學習歷程口頭發表。","images":[],"heading":false}],[{"kind":"p","text":"花生種植學習歷程發表、田野紀錄、實作觀察與小組分享。","images":[],"heading":false}]],[[{"kind":"p","text":"山海藝術與山海藝音：服飾與工藝（中年級）","images":[],"heading":false}],[{"kind":"p","text":"海岸阿美族服飾文化，頭飾、頸鍊之用途與色彩象徵。","images":[],"heading":false}],[{"kind":"p","text":"圖樣設計、串珠、四股編與流蘇、十字繡。","images":[],"heading":false}],[{"kind":"p","text":"服飾與工藝族語名稱（salilit、cangaw 等）、參訪提問。","images":[],"heading":false}],[{"kind":"p","text":"Padlet 整理、參訪提問紀錄、圖樣設計圖、串珠與編織作品、落成歌。","images":[],"heading":false}]],[[{"kind":"p","text":"山海專題：Kamamit 野番茄慢食（中年級）","images":[],"heading":false}],[{"kind":"p","text":"野番茄在部落飲食與土地利用中的位置，及慢食理念。","images":[],"heading":false}],[{"kind":"p","text":"荒地開墾、搭棚架、田間管理、果醬製作、標籤與 Logo 設計、攤位規劃。","images":[],"heading":false}],[{"kind":"p","text":"野番茄與野菜族語詞彙、攤位與成果口頭解說。","images":[],"heading":false}],[{"kind":"p","text":"觀察紀錄、小組協作紀錄、果醬成品、標籤與 Logo、Good／Change 回饋。","images":[],"heading":false}]],[[{"kind":"p","text":"山海生活與山海人文、山海專題：漁獵文化（高年級）","images":[],"heading":false}],[{"kind":"p","text":"Mipacing 漁獵技術、潮汐與季節判讀、海事倫理與禁忌。","images":[],"heading":false}],[{"kind":"p","text":"漁具與魚筌操作、潮汐與漁具觀察、耆老訪談進行。","images":[],"heading":false}],[{"kind":"p","text":"族語魚名與海事關鍵詞、向耆老提問。","images":[],"heading":false}],[{"kind":"p","text":"漁獵文化成果、訪談紀錄、潮汐與漁具觀察表、豐年祭學習成果。","images":[],"heading":false}]],[[{"kind":"p","text":"山海藝術與山海藝音：Loma’ 家屋與展演（高年級）","images":[],"heading":false}],[{"kind":"p","text":"Loma’ 家屋空間秩序、火塘 Parod、門窗方位與居住倫理。","images":[],"heading":false}],[{"kind":"p","text":"設計圖繪製、家屋模型製作、藤綁與材料辨識、Tinkercad 建模。","images":[],"heading":false}],[{"kind":"p","text":"家屋構件與方位族語詞彙、模型解說。","images":[],"heading":false}],[{"kind":"p","text":"Loma’ 家屋模型、設計圖、藤綁牢固度檢核、材料辨識、Tinkercad 檔案。","images":[],"heading":false}]],[[{"kind":"p","text":"山海專題：Mipacing 科學與智慧農業（高年級）","images":[],"heading":false}],[{"kind":"p","text":"部落生活知識與科學解釋之間的對話關係。","images":[],"heading":false}],[{"kind":"p","text":"田野筆記、實驗設計與數據蒐集、研究報告與簡報製作。","images":[],"heading":false}],[{"kind":"p","text":"研究簡報中的族語詞彙、公開發表說明。","images":[],"heading":false}],[{"kind":"p","text":"田野筆記、實驗數據、科學對話短文、研究報告全文、簡報圖表、同儕互評。","images":[],"heading":false}]]]},{"kind":"p","text":"說明：上表逐一對應本學期低、中、高年級共 8 條課程主軸，各課逐節之評量安排與實際評量紀錄，詳見「肆、附錄／五、課程教案」。","images":[],"heading":false}]},{"title":"05 族語與學習成果","blocks":[{"kind":"p","text":"（十）族語推動","images":[],"heading":false},{"kind":"p","text":"族語推動採主題式融入，將族語詞彙與實作任務連結。農耕課程融入 ariray（玉米）、kolang（芥菜）、kakorot（苦茄）、’atakiway（雞心辣椒）、sokoy（木鱉果）、fafakelo（油芒）、araciat（薏苡）、palo’（檳榔葉）、fanglay（大葉田香）、faho（藺草／輪傘草）等作物詞彙；潮間帶課程融入 Talapacay、’Angdis、Sampilaw、Piti’、Toko、Laliyok 等生物名稱；家屋課程融入 Loma’、Parod、hecek、aol、eli’、’oway 等建築詞彙；祭儀與樂舞課程則連結 Ilisin、Pisacepo’、Malikoda、Sela’l 等概念。","images":[],"heading":false},{"kind":"p","text":"族語認證通過人數","images":[],"heading":false},{"kind":"p","text":"","images":["photo-8e576a0114431f29"],"heading":false},{"kind":"table","rows":[[[{"kind":"p","text":"級別","images":[],"heading":false}],[{"kind":"p","text":"本學期通過","images":[],"heading":false}],[{"kind":"p","text":"累計通過","images":[],"heading":false}],[{"kind":"p","text":"成果說明","images":[],"heading":false}]],[[{"kind":"p","text":"初級認證","images":[],"heading":false}],[{"kind":"p","text":"3人","images":[],"heading":false}],[{"kind":"p","text":"6人","images":[],"heading":false}],[{"kind":"p","text":"能穩定累積基礎聽、說、讀能力，並連結日常問候與課程用語。","images":[],"heading":false}]],[[{"kind":"p","text":"中級認證","images":[],"heading":false}],[{"kind":"p","text":"1人","images":[],"heading":false}],[{"kind":"p","text":"4人","images":[],"heading":false}],[{"kind":"p","text":"展現進階理解與表達能力，能將族語學習延伸至文化課程與生活情境。","images":[],"heading":false}]],[[{"kind":"p","text":"中高級認證（聽力及口說）","images":[],"heading":false}],[{"kind":"p","text":"2人","images":[],"heading":false}],[{"kind":"p","text":"2人","images":[],"heading":false}],[{"kind":"p","text":"通過聽力及口說，顯示學生已能在較高層次理解與口語表達中使用族語。","images":[],"heading":false}]]]},{"kind":"p","text":"114 學年度上學期累計 6 人通過，本學期新增 6 人、累計 12 人（50%），提升 25 個百分點，且初級、中級、中高級三個級別均有學生通過。","images":[],"heading":false},{"kind":"p","text":"就年段而言，低年級 10 人以生活詞彙的聽說打底，尚未參加認證；通過者全數為中年級與高年級學生——中、高年級合計 14 人中有 12 人通過，通過率達 85.7%。低年級累積語用、中高年級銜接檢核，構成一條完整路徑。","images":[],"heading":false},{"kind":"p","text":"族語認證不只是一項考試。成效能穩定累積，正因為族語在日常課程中被持續使用，而非考前衝刺；這也提醒我們，族語終須回到孩子的日常生活、家庭對話與部落實踐之中。","images":[],"heading":false},{"kind":"p","text":"（二）各年段學習成果","images":[],"heading":false},{"kind":"p","text":"1. 低年級成果：低年級學生以身體與感官建立文化經驗。山海生活課程從菜園整地、播種、澆水、除草、作物觀察到野菜肉丸子製作，讓學生理解「一起種、一起吃、一起分享」的生活價值。潮間帶課程以影片、照片與實物帶入，學生認識退潮時的岩礁地形與採集工具，並於石門溪潮間帶進行戶外實踐，學習祭告海神、安全規範與尊重海洋生命。","images":[],"heading":false},{"kind":"p","text":"","images":["photo-8b9b847662420c0b"],"heading":false},{"kind":"p","text":"2. 中年級成果：中年級課程進入比較完整的任務歷程。山海專題以野番茄為核心，從 Palitao 晒日頭工作室、荒地開墾、搭棚架、慢食漫談、部落長輩訪談、野番茄果醬製作、商標設計與慢食節攤位構想，讓學生看見土地、食材、產業與文化創新的關係。","images":[],"heading":false},{"kind":"p","text":"","images":["photo-df10b0a09fd2323a"],"heading":false},{"kind":"p","text":"Padlet 114-2中年級山海生活--農耕技術、潮間生物(海哥二馬)：中年級 山海生活看板全版紀錄，呈現課程作品、歷程紀錄與教師彙整脈絡。","images":[],"heading":false},{"kind":"p","text":"","images":["photo-e7470456c473f26d"],"heading":false},{"kind":"p","text":"3. 高年級成果：高年級課程朝向文化研究與公開表達。山海生活以漁獵文化為核心，學生認識潮汐、漁具、分工與禁忌，理解「取之有度」的海洋倫理。山海藝術以 Loma’ 家屋文化探究與模型實作為主；高年級專題則以 Mipacing 漁獵科學、科博會參賽練習實施。","images":[],"heading":false},{"kind":"p","text":"","images":["photo-dc8328fdaf987a99"],"heading":false},{"kind":"p","text":"Padlet 114下高年級山海生活--漁獵技術(mifoting)：高年級 山海生活看板全版紀錄，呈現課程作品、歷程紀錄與教師彙整脈絡。","images":[],"heading":false},{"kind":"p","text":"","images":["photo-4924488d308c8f04"],"heading":false},{"kind":"p","text":"４. 成果展與學生作品：115年6月18日辦理實驗教育成果展，上午銜接畢業典禮與文化實作，下午以靜態展、闖關、論壇、樂舞展演與Pakelang完功宴呈現本學期學習歷程。展場包含高年級漁獵體驗與Loma’家屋模型、中年級野菜標本族語與十字繡串珠、低年級豐年祭圖畫與色彩作品；學生不只展示作品，也練習以族語關鍵詞、中文說明與身體展演回應家長、部落長者及來賓提問。","images":["photo-d9a276355f3e6326","photo-498d2d060c976cd1","photo-ff42138e495b1c8e","photo-6077d22a384c07f6"],"heading":false}]},{"title":"06 耆老參與與社區合作","blocks":[{"kind":"p","text":"（八）講師、耆老參與課程","images":[],"heading":false},{"kind":"p","text":"本學期耆老與講師入班參與形式包含部落故事講述、祭儀倫理說明、潮間帶採集示範、傳統農耕與野菜知識、漁獵工具與禁忌、樂舞與歌謠指導、傳統服飾與工藝示範、Loma’ 家屋建築知識與族語詞彙支持。耆老入班的價值不只在補充資料，更在示範文化知識如何被說、被做、被分享，也讓學生學習面對長輩時的聆聽與提問倫理。","images":[],"heading":false},{"kind":"p","text":"本學期漁獵（Mipacing）專題之文化知識，由部落耆老與文化講師共同指導：一位部落耆老以阿美族語魚名，帶學生讀出魚的外形、棲地、季節與危險，讓學生體會「當族語魚名消失，名字背後的海洋記憶也可能跟著消失」。一位女性 Mipacingay 長者以生命經驗，引導學生理解魚類行為、就地取材與身體記憶，並說明許多被稱為「禁忌」的提醒，其實保存著前人用生命累積的安全智慧；文化講師則傳授傳統魚槍選材、水下瞄準、月相潮汐、中性浮力與「不貪心、抱卵放生、漁獲分享」的海洋倫理。","images":[],"heading":false},{"kind":"p","text":"此一師徒共學模式，體現部落知識由長者親身傳遞、學生親手實作、再以科學驗證與公開發表的完整歷程，可概括為「聽耆老說、向部落問、親手做、用科學驗證、向外分享」五個階段，具體展現本校民族教育中部落與學校的深度共學。","images":[],"heading":false},{"kind":"p","text":"（九）部落連結與資源整合","images":[],"heading":false},{"kind":"p","text":"本學期部落連結表現在三個層面：第一，部落耆老與族專師入班，為本校民族教育之主要知識來源，其入班參與形式與具體實例詳見「（八）講師、耆老參與課程」。第二，課程以真實場域為教材，如菜園、潮間帶、部落家屋、Palitao 晒日頭工作室與成果展場。第三，透過家長志工與海女 Ina 參與，讓學生看見文化知識仍在當代部落生活中被實踐。這樣的連結使學校成為文化轉譯的中介，不是把部落知識搬進教室而已，而是讓學生在場域中學會如何尊重、詢問、記錄與回饋。","images":[],"heading":false},{"kind":"p","text":"校內外資源網絡","images":[],"heading":false},{"kind":"p","text":"本校民族教育的資源連結不僅止於校內與部落，亦向政府部門、校際與公共活動延伸，形成內外協力的資源網絡（如下表）：","images":[],"heading":false},{"kind":"table","rows":[[[{"kind":"p","text":"合作對象","images":[],"heading":false}],[{"kind":"p","text":"類別","images":[],"heading":false}],[{"kind":"p","text":"合作內容","images":[],"heading":false}]],[[{"kind":"p","text":"八桑安部落長者大俱來部落長者僅那鹿角部落長者","images":[],"heading":false}],[{"kind":"p","text":"部落","images":[],"heading":false}],[{"kind":"p","text":"海祭、漁獵、農耕、樂舞知識來源與課程共備、文化正確性確認","images":[],"heading":false}]],[[{"kind":"p","text":"臺東縣政府（教育處）","images":[],"heading":false}],[{"kind":"p","text":"政府","images":[],"heading":false}],[{"kind":"p","text":"實驗教育督導、2026 臺東博覽會展演邀請","images":[],"heading":false}]],[[{"kind":"p","text":"2026 臺東博覽會（桃園機場記者會）","images":[],"heading":false}],[{"kind":"p","text":"政府／活動","images":[],"heading":false}],[{"kind":"p","text":"阿美族古謠公開展演","images":[],"heading":false}]],[[{"kind":"p","text":"長濱金剛馬拉松主辦單位","images":[],"heading":false}],[{"kind":"p","text":"在地活動","images":[],"heading":false}],[{"kind":"p","text":"選手之夜古謠展演（新創祈晴歌與傳統古調）","images":[],"heading":false}]],[[{"kind":"p","text":"達魯瑪克實驗小學","images":[],"heading":false}],[{"kind":"p","text":"校際","images":[],"heading":false}],[{"kind":"p","text":"民族教育參訪與課程交流","images":[],"heading":false}]],[[{"kind":"p","text":"原住民族文化與科學展覽會","images":[],"heading":false}],[{"kind":"p","text":"競賽／學術","images":[],"heading":false}],[{"kind":"p","text":"漁獵專題科展、銀熊獎、原住民族科學傳播獎","images":[],"heading":false}]],[[{"kind":"p","text":"家長志工與海女 Ina","images":[],"heading":false}],[{"kind":"p","text":"社區／家庭","images":[],"heading":false}],[{"kind":"p","text":"食農、潮間帶踏查與成果展協力","images":[],"heading":false}]]]},{"kind":"p","text":"說明：上述連結使部落知識得以在校內課程、跨校交流與公共場域之間流動，兼顧文化傳承的深度與能見度。","images":[],"heading":false},{"kind":"p","text":"（六）校際交流與跨校對話","images":[],"heading":false},{"kind":"p","text":"本學期安排達魯瑪克實驗小學參訪與課程交流，目的在於觀摩他校如何將部落文化、校園空間、文物展示、學生作品與課程評量整合為可持續運作的民族教育環境。參訪歷程包含文化展示導覽、民族教育成果牆觀察、課程理念分享、家屋模型觀察、校園空間走讀與文物展櫃交流，協助本校教師從課程架構、師資協作、學習證據蒐集與場域營造等面向反思 Salimpo 課程的精進方向。","images":[],"heading":false},{"kind":"p","text":"","images":["photo-ee695797c1e4c193"],"heading":false}]},{"title":"07 教學自評與精進方向","blocks":[{"kind":"p","text":"五、自評與建議","images":[],"heading":false},{"kind":"table","rows":[[[{"kind":"p","text":"困難","images":[],"heading":false}],[{"kind":"p","text":"因應作為","images":[],"heading":false}],[{"kind":"p","text":"次年度改進方向","images":[],"heading":false}]],[[{"kind":"p","text":"族語日常化仍需深化。","images":[],"heading":false}],[{"kind":"p","text":"已將作物、歌謠、潮間帶與展演詞彙融入課程，並推動族語認證。","images":[],"heading":false}],[{"kind":"p","text":"設計家庭共說、部落長者對話與每日課堂用語任務，讓族語從認證延伸到生活使用。","images":[],"heading":false}]],[[{"kind":"p","text":"課程模組與評量證據需更聚焦。","images":[],"heading":false}],[{"kind":"p","text":"已整理教案、Padlet、成果展、作品、專題研究與滿意度資料。","images":[],"heading":false}],[{"kind":"p","text":"建立三美九向年段課程地圖、評量規準與學生學習證據清單，降低活動羅列感。","images":[],"heading":false}]],[[{"kind":"p","text":"自然素材與工藝課程可再系統化。","images":[],"heading":false}],[{"kind":"p","text":"已辦理月桃葉編織研習，課程含串珠、毛球、Loma’家屋、藤綁與竹編。","images":[],"heading":false}],[{"kind":"p","text":"規劃自然素材工藝課程線，明確標示材料處理、安全規範、文化意義與作品評量。","images":[],"heading":false}]],[[{"kind":"p","text":"家校部落溝通可更制度化。","images":[],"heading":false}],[{"kind":"p","text":"已透過耆老入班、成果展、參訪交流與滿意度回饋蒐集意見。","images":[],"heading":false}],[{"kind":"p","text":"固定家長／部落回饋表、文化教師共備紀錄與期末回饋會議，讓部落參與由支援走向共構。","images":[],"heading":false}]]]}]}]}